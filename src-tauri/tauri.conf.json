{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidLibOrganizer",
  "version": "0.2.0",
  "identifier": "com.vidliborganizer.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "VidLibOrganizer",
      "width": 1360,
      "height": 900,
      "minWidth": 800,
      "minHeight": 600,
      "backgroundColor": "#101417"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
